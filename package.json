{
  "name": "sweezy-news-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram editorial approval bot for Sweezy community",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.35.0",
    "node-cron": "^4.2.1",
    "openai": "^6.49.0",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
